# BrocAI 10.8 — configuration du control plane Mac.
# Copier vers ~/.config/brocai/ops.env et chmod 600.

BROCAI_VPS_HOST=CHANGE_ME_VPS_IP_OR_HOSTNAME
BROCAI_VPS_USER=ubuntu
BROCAI_VPS_SSH_KEY=$HOME/.ssh/brocai_vps_ed25519
BROCAI_VPS_APP_DIR=/srv/brocai/app
BROCAI_VPS_ENV_FILE=/srv/brocai/.env
BROCAI_VPS_DATA_DIR=/srv/brocai/data
BROCAI_VPS_TUNNEL_SERVICE=cloudflared-brocai-vps.service

BROCAI_STANDBY_ROOT=$HOME/BrocAI-standby
BROCAI_STANDBY_APP_PORT=8081
BROCAI_REPOSITORY_URL=https://github.com/nicolasbour2018-dot/Broc_AI.git
BROCAI_STANDBY_BRANCH=step10.8-cloudflare-standby

BROCAI_PUBLIC_HOSTNAME=CHANGE_ME_PUBLIC_HOSTNAME
BROCAI_OPS_HOSTNAME=CHANGE_ME_OPS_HOSTNAME
BROCAI_VPS_TUNNEL_ID=CHANGE_ME_VPS_TUNNEL_UUID
BROCAI_MAC_TUNNEL_ID=CHANGE_ME_MAC_TUNNEL_UUID
BROCAI_OPS_TUNNEL_ID=CHANGE_ME_OPS_TUNNEL_UUID

# Token Cloudflare limité à la zone BrocAI, permissions DNS Write (+ Zone Read si souhaité).
CLOUDFLARE_ZONE_ID=CHANGE_ME_ZONE_ID
CLOUDFLARE_API_TOKEN=CHANGE_ME_SCOPED_API_TOKEN
# Facultatif : si vide, le record CNAME est découvert par son hostname.
CLOUDFLARE_DNS_RECORD_ID=

# Défense supplémentaire derrière Cloudflare Access.
BROCAI_OPS_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
BROCAI_OPS_ACTOR=Nicolas
BROCAI_OPS_BIND_HOST=127.0.0.1
BROCAI_OPS_PORT=8765
