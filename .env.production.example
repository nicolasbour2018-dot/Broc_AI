# BrocAI production — copy to /srv/brocai/.env on the VPS.
# Never commit the real file.

BROCAI_DATA_DIR=/srv/brocai/data
APP_BIND_HOST=127.0.0.1
APP_PORT=8080

POSTGRES_DB=brocai
POSTGRES_USER=brocai
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD

# Same-origin traffic through nginx does not require permissive CORS.
CORS_ORIGINS=

MAX_UPLOAD_MB=8
IMAGE_MAX_EDGE_PX=1920
IMAGE_JPEG_QUALITY=90
IMAGE_WEBP_QUALITY=90

AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_QUALITY_MODEL=gemini-3.6-flash
AI_FORCE_QUALITY_SCALE_UP=false

HF_TOKEN=CHANGE_ME_HUGGING_FACE_TOKEN
HF_ROUTER_URL=https://router.huggingface.co/v1/chat/completions
HF_QWEN_MODEL=Qwen/Qwen3.5-35B-A3B:deepinfra
HF_TIMEOUT_SECONDS=30
HF_FALLBACK_MAX_ATTEMPTS=3

AI_ROUTING_MODE=auto
AI_FORCE_PRIMARY_FAILURE=false
MAX_AI_IN_FLIGHT=20
MAX_FUN_IN_FLIGHT=4
AI_JOB_TIMEOUT_SECONDS=60
AI_WORKER_POLL_MS=250
AI_JOB_RETENTION_HOURS=12

ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_ADMIN_TOKEN
